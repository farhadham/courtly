{
  "name": "courtly",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build -w @courtly/contracts && npm run build -w @courtly/api && npm run build -w @courtly/web",
    "typecheck": "npm run build -w @courtly/contracts && npm run typecheck -w @courtly/api && npm run typecheck -w @courtly/web",
    "lint": "npm run build -w @courtly/contracts && eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test -w @courtly/api",
    "check": "npm run format:check && npm run lint && npm run typecheck",
    "dev:api": "npm run dev -w @courtly/api",
    "dev:web": "npm run dev -w @courtly/web",
    "db:generate": "npm run db:generate -w @courtly/api",
    "db:migrate": "npm run db:migrate -w @courtly/api",
    "db:seed": "npm run db:seed -w @courtly/api"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.72.1"
  }
}
