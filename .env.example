# Copy to .env for local (non-Docker) development.
# docker compose provides these values itself.

DATABASE_URL=postgres://courtly:courtly@localhost:5432/courtly
# The test suite creates courtly_test on first run, and refuses to touch a
# database whose name does not end in _test.
TEST_DATABASE_URL=postgres://courtly:courtly@localhost:5432/courtly_test
JWT_SECRET=dev-secret-change-me
PORT=3001
