# Copy to .env for local (non-Docker) development.
# docker compose provides these values itself.
#
# The Compose database publishes on host port 5433, so it can run next to a
# local PostgreSQL on 5432.

DATABASE_URL=postgres://courtly:courtly@localhost:5433/courtly
# The test suite creates courtly_test on first run, and refuses to touch a
# database whose name does not end in _test.
TEST_DATABASE_URL=postgres://courtly:courtly@localhost:5433/courtly_test
JWT_SECRET=dev-secret-change-me
PORT=3001
